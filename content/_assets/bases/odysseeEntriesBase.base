views:
  - type: table
    name: Tout
    filters:
      and:
        - publish == true
        - or:
            - file.path.startsWith("odyssée/")
            - file.path.startsWith("public/odyssée/")
        - '!file.folder.startsWith("_")'
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - tags
    sort:
      - property: file.folder
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 320
