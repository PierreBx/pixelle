views:
  - type: table
    name: Tout
    filters:
      and:
        - publish == true
        - or:
            - file.path.startsWith("blog/")
            - file.path.startsWith("public/blog/")
    order:
      - file.ctime
      - file.name
      - category
      - tags
      - description
    sort:
      - property: file.ctime
        direction: ASC
      - property: category
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 235
  - type: list
    name: Liste
    filters:
      and:
        - file.folder.containsAny("blog", "posts", "odyssée")
        - '!file.name.startsWith("_")'
        - file.name != "index"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
