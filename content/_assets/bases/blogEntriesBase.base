views:
  - type: table
    name: Tout
    filters:
      and:
        - publish == true
        - or:
            - file.path.startsWith("blog/")
            - file.path.startsWith("public/blog/")
    order:
      - file.name
      - category
      - tags
      - description
    sort:
      - property: created
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 235
