views:
  - type: table
    name: Tout
    filters:
      and:
        - publish == true
        - or:
            - file.path.startsWith("posts/")
            - file.path.startsWith("public/posts/")
    order:
      - file.name
      - tags
      - file.ctime
      - description
    sort:
      - property: file.ctime
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 320
      note.description: 183
